<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.xinmengqaq.springboot.article.mapper.ArticleMapper">
    <!-- 查询文章详情，根据文章 ID 查询 -->
    <select id="selectById" resultType="com.xinmengqaq.springboot.article.entity.Article">
        select id, <include refid="articleColumns"/>
        from article
        where id = #{id}
    </select>

    <!-- [MyBatis] useGeneratedKeys + keyProperty + keyColumn 主键回填
         INSERT 后把数据库生成的自增主键回写到实体对象的 keyProperty 字段，供后续代码直接用 entity.getId()。
         useGeneratedKeys=true 开启回填，keyProperty 指定实体属性名，keyColumn 指定数据库列名（属性名和列名一致时可省略）。
         依赖 PG 的 generated by default as identity 自增列，MyBatis 拿到 JDBC 返回的生成键再反射写入实体。 -->
    <!-- 新增文章 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        insert into article (<include refid="articleColumns"/>)
        values (
            #{categoryId}, #{title}, #{summary}, #{content}, #{coverUrl},
            #{status}, #{isTop}, #{isRecommend},
            #{publishedAt}, #{createdAt}, #{updatedAt}
        )
    </insert>


    <!-- [MyBatis] <sql> + <include> 片段复用
         <sql id="名"> 定义可复用的 SQL 片段（常是一组字段列），<include refid="名"/> 在任意位置引用它，拼接时原样展开。
         适合多个查询共用同一组字段列，避免每个 SELECT 重复写一大串列名，改字段时只改 <sql> 一处。
         字段片段只放真实列名，不放 count(...) 或 case when 这类计算列，避免复用到 group by 时污染 SQL。 -->
    <!-- 文章列定义 -->
    <sql id="articleColumns">
        category_id, title, summary, content, cover_url, status,
        is_top, is_recommend, published_at, created_at, updated_at
    </sql>

    <!-- 根据 ID 更新文章 -->
    <update id="updateById">
        update article
        <set>
            category_id = #{categoryId},
            <if test="title != null and title != ''">
                title = #{title},
            </if>
            <if test="summary != null">
                summary = #{summary},
            </if>
            <if test="content != null and content != ''">
                content = #{content},
            </if>
            <if test="coverUrl != null">
                cover_url = #{coverUrl},
            </if>
            <if test="status != null and status != ''">
                status = #{status},
                published_at = case
                    when #{status} = 'published' and published_at is null then #{updatedAt}
                    else published_at
                end,
            </if>
            <if test="isTop != null">
                is_top = #{isTop},
            </if>
            <if test="isRecommend != null">
                is_recommend = #{isRecommend},
            </if>
            updated_at = #{updatedAt}
        </set>
        where id = #{id}
    </update>

    <!-- 更新文章状态 -->
    <update id="updateStatus">
        update article
        set status = #{status},
        published_at = case
        when #{status} = 'published' and published_at is null
        then #{updatedAt}
        else published_at
        end,
        updated_at = #{updatedAt}
        where id = #{id}
    </update>

    <!-- 更新文章置顶状态 -->
    <update id="updateTop">
        update article
        set is_top = #{isTop},
        updated_at = #{updatedAt}
        where id = #{id}
    </update>

    <!-- 更新文章推荐状态 -->
    <update id="updateRecommend">
        update article
        set is_recommend = #{isRecommend},
        updated_at = #{updatedAt}
        where id = #{id}
    </update>

    <!-- 根据 ID 删除文章 -->
    <delete id="deleteById">
        delete from article where id = #{id}
    </delete>

    <!-- [MyBatis] <foreach> 集合展开
         遍历集合生成 SQL 片段：collection 是参数名，item 是循环变量，open/close 是首尾包裹符，separator 是元素间分隔符。
         常用于 IN (...) 条件（open="(" close=")" separator=","）和批量 VALUES（separator=","）。
         集合必须先校验非空再进 <foreach>，否则生成 `in ()` 非法 SQL；MyBatis 不会自动拦截空集合。 -->
    <!-- 根据 ID 列表批量删除文章 -->
    <delete id="deleteByIds">
        delete from article
        where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <sql id="articleListColumns">
        a.id,
        a.category_id,
        c.name as category_name,
        a.title,
        a.summary,
        a.cover_url,
        a.status,
        a.is_top,
        a.is_recommend,
        a.view_count,
        a.comment_count,
        a.published_at,
        a.created_at,
        a.updated_at
    </sql>

    <!-- [MyBatis] <where> 动态 WHERE 子句
         <where> 包裹条件块，内部有有效条件时自动生成 WHERE，并移除开头多余的 AND/OR，避免 WHERE AND 语法错。
         内部全无有效条件时不生成 WHERE，查全表。配合 <if> 实现可选筛选条件组合。 -->
    <!-- 查询文章列表，带分页 -->
    <select id="selectPage" resultType="com.xinmengqaq.springboot.article.vo.ArticleListVO">
        select
        <include refid="articleListColumns"/>
        from article a
        <!-- [PgSQL] LEFT JOIN ... ON
             左连接保留左表（article）所有行，右表（category）无匹配时右表字段返回 NULL，不丢弃左表行。
             和 INNER JOIN 区别：INNER JOIN 只返回两表都匹配的行，左表无匹配会丢。
             ON 指定连接条件，这里 c.id = a.category_id 把分类信息挂到文章上。 -->
        left join category c on c.id = a.category_id
        <where>
            <!-- 搜索关键词 -->
            <if test="keyword != null and keyword != ''">
                and (
                <!-- [MyBatis·PgSQL] LIKE concat('%', #{keyword}, '%')
                     #{} 是预编译参数占位，MyBatis 把值作为 PreparedStatement 参数传入，自动防 SQL 注入。
                     PG 的 concat 函数拼接通配符和参数，生成 like '%关键词%'；不能用 ${} 直接拼接，否则有注入风险。 -->
                a.title like concat('%', #{keyword}, '%')
                or a.summary like concat('%', #{keyword}, '%')
                )
            </if>

            <!-- 状态查询 -->
            <if test="status != null and status != ''">
                and a.status = #{status}
            </if>

            <!-- 分类查询 -->
            <if test="categoryId != null">
                and a.category_id = #{categoryId}
            </if>

            <!-- 标签查询 -->
            <if test="tagId != null">
                <!-- [PgSQL] EXISTS 子查询
                     EXISTS 判断子查询是否返回至少一行，返回 true/false，比 IN 子查询性能更好（EXISTS 命中即停）。
                     子查询引用外查询的 a.id（相关子查询），逐行判断文章是否绑定了指定标签。
                     比 JOIN article_tag 更好：JOIN 会让一篇文章重复出现，EXISTS 只判断存在不重复。 -->
                and exists (
                select 1
                from article_tag at_filter
                where at_filter.article_id = a.id
                and at_filter.tag_id = #{tagId}
                )
            </if>
        </where>
        <!-- [PgSQL] ORDER BY ... NULLS LAST
             NULLS LAST 是 PG 特有语法，控制 NULL 值在排序中的位置：LAST 放末尾，FIRST 放开头。
             PG 默认升序 NULL 在最后、降序 NULL 在最前，和直觉不同，显式写 NULLS LAST 避免未发布的文章（published_at 为 NULL）排在前面。
             多字段排序按声明顺序定优先级：先 is_top 置顶，再 published_at 发布时间，最后 id 做稳定兜底。 -->
        order by
        a.is_top desc,
        a.published_at desc nulls last,
        a.created_at desc,
        a.id desc
    </select>

    <!-- 查询文章详情，带分类名称 -->
    <select id="selectDetailById" resultType="com.xinmengqaq.springboot.article.vo.ArticleDetailVO">
        select
        <include refid="articleListColumns"/>,
        a.content
        from article a
        left join category c on c.id = a.category_id
        where a.id = #{id}
    </select>



</mapper>

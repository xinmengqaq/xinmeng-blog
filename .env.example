# 部署模式：opensource 创建业务库和测试库；server 只使用业务库
DEPLOY_MODE=opensource

# PostgreSQL 业务数据库名称
DB_NAME=spring_blog
# PostgreSQL 用户名，Spring Boot 和 FastAPI 共用
DB_USER=blog
# PostgreSQL 密码，不要提交真实密码
DB_PASSWORD=CHANGE_ME
# PostgreSQL 数据目录，必须长期保留，删除会丢失数据库数据
PGDATA_HOST=C:/docker/blog_pgdata

# Spring Boot 和 FastAPI 共用的 JWT 密钥
JWT_SECRET=CHANGE_ME

# SMTP 邮件服务器配置；不发送邮件时也可以留空账号密码
MAIL_HOST=smtp.qq.com
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=465

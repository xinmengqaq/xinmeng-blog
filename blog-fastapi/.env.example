# 运行环境：development 打开 SQL 日志；production 关闭
APP_ENV=development
DOCS_ENABLED=true

# PostgreSQL 异步连接串：驱动+用户:密码@主机:端口/库名
# 真实密码写在 .env（被 .gitignore 忽略）；这里只给占位示例
DATABASE_URL=postgresql+asyncpg://blog_remote:CHANGE_ME@localhost:5433/spring_blog
DB_ECHO=true

# 控制台应用日志级别（Loguru）：DEBUG/INFO/WARNING...
LOG_LEVEL=DEBUG




JWT_SECRET=

# Token 有效时长（秒）
JWT_EXPIRE_SECONDS=28800

# 时钟偏移（秒）
JWT_CLOCK_SKEW_SECONDS=120

# OpenAI 协议上游地址（兼容 OpenAI、DeepSeek、OpenRouter 等）
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=

# 思考等级：low/medium/high（受模型支持与否影响）
OPENAI_REASONING_EFFORT=medium

# 上下文窗口大小（token 数）
OPENAI_CONTEXT_WINDOW=65536
